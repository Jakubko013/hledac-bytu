# Copy to .env for local development. Never commit real values.

# Users allowed to log in: comma-separated "user:scryptHash" pairs.
# Generate a hash with: npx tsx scripts/hash-password.ts '<password>'
# Hash format: scrypt$N$r$p$saltB64$hashB64 (contains no comma or colon).
APP_USERS=

# Secret for HMAC-signing the session cookie. Use >= 32 random bytes, e.g. `openssl rand -base64 48`.
SESSION_SECRET=

# Shared secret for crawl endpoints (x-crawl-secret header). e.g. `openssl rand -hex 32`.
CRAWL_SECRET=

# Netlify Database connection string. Injected automatically on Netlify; set only for local/CLI use.
NETLIFY_DB_URL=

# Postgres connection string for GitHub Actions crawl and local use / fallback when NETLIFY_DB_URL is absent.
DATABASE_URL=
