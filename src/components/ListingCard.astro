---
import type { ListingCard } from '../lib/view-types';
import FactorBars from './FactorBars.astro';
import ListingStateForm from './ListingStateForm.astro';
import ScoreRing from './ScoreRing.astro';
import { CONDITION_LABEL, PORTAL_LABEL, formatCzk, formatCzkOrDash, formatKm, formatNumber, pricePerM2 } from '../lib/format';

interface Props {
  listing: ListingCard;
  next: string;
  eager?: boolean;
}
const { listing: l, next, eager = false } = Astro.props;
const perM2 = pricePerM2(l.price_czk, l.area_m2);
const photoCount = l.images.length;
const photoLabel = `${photoCount} ${photoCount === 1 ? 'fotka' : photoCount >= 2 && photoCount <= 4 ? 'fotky' : 'fotek'}`;
const detailHref = `/listing/${l.id}?c=${l.criteria_id}`;
---
<article class="card listing-card">
  <div class="media">
    {photoCount > 0 ? (
      <>
        <img class="thumb" src={l.images[0]} width="640" height="480" alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : undefined} />
        <a class="thumb-link" href={l.images[0]} target="_blank" rel="noopener noreferrer"
          data-lb-group={`card-${l.id}`} data-lb-index="0" data-lb-detail={detailHref} data-lb-alt={l.title}
          aria-label={photoCount > 1 ? `Zvětšit fotografie (${photoLabel}): ${l.title}` : `Zvětšit fotografii: ${l.title}`}></a>
        {l.images.slice(1).map((src, i) => (
          <a class="visually-hidden" href={src} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true"
            data-lb-group={`card-${l.id}`} data-lb-index={i + 1} data-lb-detail={detailHref} data-lb-alt={l.title}></a>
        ))}
        <span class="zoom-chip" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            {photoCount > 1
              ? <><rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="9" cy="10" r="1.5" /><path d="m21 16-5-5-8 8" /></>
              : <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />}
          </svg>
          {photoCount > 1 ? photoLabel : 'Zvětšit'}
        </span>
      </>
    ) : <div class="no-photo" role="img" aria-label="Bez fotografie">Bez fotografie</div>}
    {(l.is_new || l.price_drop_pct != null) && (
      <div class="badges">
        {l.is_new && <span class="badge badge-new">Nové</span>}
        {l.price_drop_pct != null && <span class="badge badge-drop">Zlevněno −{l.price_drop_pct} %</span>}
      </div>
    )}
  </div>
  <div class="body">
    <div class="top">
      <div>
        <p class="eyebrow">{PORTAL_LABEL[l.portal]} · {l.locality_text}</p>
        <h2><a href={detailHref}>{l.title}</a></h2>
      </div>
      <ScoreRing score={l.score} />
    </div>
    <div class="price-row">
      <p class="price">{formatCzkOrDash(l.price_czk)}</p>
      {perM2 != null && <span class="per">{formatNumber(perM2)}&nbsp;Kč/m²</span>}
      {l.fees_czk ? <span class="fees">+ {formatCzk(l.fees_czk)} poplatky</span> : null}
    </div>
    <ul class="facts">
      <li>{l.layout ?? '–'}</li>
      <li>{l.area_m2 ? `${formatNumber(l.area_m2)} m²` : '–'}</li>
      {l.distance_km != null && <li>{formatKm(l.distance_km)} od centra</li>}
    </ul>
    <div><span class="tag">{CONDITION_LABEL[l.condition]}</span></div>
    {l.also_on.length > 0 && <p class="also">také na: {l.also_on.map((p) => PORTAL_LABEL[p]).join(', ')}</p>}
  </div>
  <div class="score-box">
    <FactorBars breakdown={l.breakdown} />
    <ListingStateForm listing_id={l.id} status={l.status} next={next} />
  </div>
</article>
