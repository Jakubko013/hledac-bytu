---
import '../styles/global.css';
import Lightbox from '../components/Lightbox.astro';

interface Props {
  title: string;
  /** Show header navigation (false to hide it). */
  nav?: boolean;
}
const { title, nav = true } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Přehled', match: (p: string) => p === '/' || p.startsWith('/listing') },
  { href: '/criteria', label: 'Hledání', match: (p: string) => p.startsWith('/criteria') },
  { href: '/health', label: 'Stav', match: (p: string) => p.startsWith('/health') },
];
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f7f3ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131210" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href="/fonts/cormorant-latin-600.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title} · hledač bytu</title>
  </head>
  <body>
    <a class="skip" href="#main">Přeskočit na obsah</a>
    {nav && (
      <header class="site-header">
        <div class="container">
          <a class="brand" href="/">hledač bytu</a>
          <nav class="site-nav" aria-label="Hlavní navigace">
            {links.map((l) => (
              <a href={l.href} aria-current={l.match(path) ? 'page' : undefined}>{l.label}</a>
            ))}
          </nav>
        </div>
      </header>
    )}
    <main id="main" class={nav ? 'container' : undefined}>
      <slot />
    </main>
    {nav && <Lightbox />}
  </body>
</html>
